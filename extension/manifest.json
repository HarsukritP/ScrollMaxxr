{
  "manifest_version": 3,
  "name": "ScrollMaxxr - FYP Calibrator",
  "version": "1.0.0",
  "description": "AI-powered TikTok FYP optimization. Stop scrolling past content you hate.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}

